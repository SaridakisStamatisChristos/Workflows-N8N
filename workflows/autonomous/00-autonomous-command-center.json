    {
      "parameters": {"mode":"runOnceForEachItem","jsCode":"const b=($json.body&&typeof $json.body==='object')?$json.body:{};const task=String(b.task||'').trim();if(!task)throw new Error('body.task is required');if(task.length>20000)throw new Error('task too long');const rid=(typeof b.request_id==='string'&&/^[A-Za-z0-9._:-]{1,120}$/.test(b.request_id))?b.request_id:`req_${Date.now()}_${Math.random().toString(36).slice(2,9)}`;return[{json:{request_id:rid,task,context:b.context||{},model:typeof b.model==='string'?b.model:'gpt-6.1-sol',priority:['low','normal','high','critical'].includes(b.priority)?b.priority:'normal',repo:b.repository_full_name||'',path:b.path||'',received_at:new Date().toISOString()}}];"},
