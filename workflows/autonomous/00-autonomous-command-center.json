    {"parameters":{"mode":"runOnceForEachItem","jsCode":"const src=$('Parse Router').item.json; const out=$json; const rank={low:0,moderate:1,high:2,critical:3}; const risk=String(out.risk_level||src.router.risk_hint||'moderate'); let action=src.requested_action?JSON.parse(JSON.stringify(src.requested_action)):null; if(action){action.payload=action.payload||{}; if(action.type==='gmail_send'&&!action.payload.body&&out.draft)action.payload.body=out.draft; if(action.type==='telegram_notify'&&!action.payload.text&&(out.summary_markdown||out.draft))action.payload.text=out.summary_markdown||out.draft;} const approval=!!action||out.requires_human_approval===true||rank[risk]>=2||src.priority==='critical'; return[{json:{...out,request_id:src.request_id,route:src.router.route,risk_level:risk,requires_human_approval:approval,router:src.router,requested_action:action}}];"},"id":"cc13","name":"Policy Gate","type":"n8n-nodes-base.code","typeVersion":2,"position":[940,0]},
