    {"parameters":{"mode":"runOnceForEachItem","jsCode":"const b=($json.body&&typeof $json.body==='object')?$json.body:$json; const approved=b.approved===true||String(b.approved).toLowerCase()==='true'; const original=$('Policy Gate').item.json; return[{json:{...original,human_approval:{approved,note:String(b.note||'').slice(0,1000),decided_at:new Date().toISOString()}}}];"},"id":"cc20","name":"Validate Approval","type":"n8n-nodes-base.code","typeVersion":2,"position":[2180,120]},
