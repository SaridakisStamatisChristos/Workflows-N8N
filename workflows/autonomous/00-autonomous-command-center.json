    },
    {
      "parameters":{"mode":"runOnceForEachItem","jsCode":"function t(r){if(typeof r?.output_text==='string')return r.output_text;for(const x of(r?.output||[]))for(const c of(x?.content||[]))if(typeof c?.text==='string')return c.text;return null}const raw=t($json)||'{}';let p={};try{p=JSON.parse(raw.replace(/^```(?:json)?\\s*/i,'').replace(/\\s*```$/,''))}catch{p={route:'general',reason:'router parse fallback',risk_hint:'moderate',confidence:0}};const allowed=['research','engineering','communications','github','general'];if(!allowed.includes(p.route))p.route='general';const src=$('Normalize').item.json;return[{json:{...src,router:p}}];"},
